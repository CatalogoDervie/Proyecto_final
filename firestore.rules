rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isActiveSuperadmin() {
      return signedIn()
        && currentProfile().data.active == true
        && currentProfile().data.role == 'superadmin';
    }

    function validUserProfile() {
      return request.resource.data.keys().hasAll([
          'email', 'role', 'clinica', 'active', 'nombre'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'role', 'clinica', 'active', 'nombre'
        ])
        && request.resource.data.email is string
        && request.resource.data.nombre is string
        && request.resource.data.active is bool
        && request.resource.data.role in [
          'superadmin', 'administrativo', 'medico', 'supervisor'
        ]
        && request.resource.data.clinica in [
          'ambas', 'clinica_a', 'clinica_b'
        ]
        && (
          (request.resource.data.role == 'administrativo'
            && request.resource.data.clinica in ['clinica_a', 'clinica_b'])
          || (request.resource.data.role in ['medico', 'supervisor', 'superadmin']
            && request.resource.data.clinica == 'ambas')
        );
    }

    function normalUserKeepsProtectedFields() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.clinica == resource.data.clinica
        && request.resource.data.active == resource.data.active;
    }

    match /usuarios/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || isActiveSuperadmin());
      allow list: if isActiveSuperadmin();

      allow create: if isActiveSuperadmin() && validUserProfile();
      allow delete: if isActiveSuperadmin();
      allow update: if validUserProfile()
        && (
          isActiveSuperadmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && normalUserKeepsProtectedFields()
          )
        );
    }

    function isActiveRole(role) {
      return signedIn()
        && currentProfile().data.active == true
        && currentProfile().data.role == role;
    }
    function isSupervisor() { return isActiveRole('supervisor'); }
    function isMedico() { return isActiveRole('medico'); }
    function isAdministrativo() { return isActiveRole('administrativo'); }
    function validClinic(clinica) { return clinica in ['clinica_a', 'clinica_b']; }
    function ownClinic(clinica) {
      return isAdministrativo()
        && currentProfile().data.clinica == clinica
        && validClinic(clinica);
    }
    function argentinaTodayKey() {
      let localNow = request.time - duration.value(3, 'h');
      return localNow.year() * 10000 + localNow.month() * 100 + localNow.day();
    }
    function canReadCirugia() {
      return isActiveSuperadmin() || isSupervisor() || isMedico()
        || ownClinic(resource.data.clinica)
        || (
          isAdministrativo()
          && resource.data.programadaHastaDia is int
          && resource.data.programadaHastaDia > argentinaTodayKey()
        );
    }
    function canWriteCirugia() {
      return isActiveSuperadmin() || isSupervisor()
        || (ownClinic(resource.data.clinica)
          && request.resource.data.clinica == resource.data.clinica);
    }
    function validCirugia() {
      return request.resource.data.clinica is string
        && validClinic(request.resource.data.clinica)
        && request.resource.data.estadoCir in ['', 'Programada', 'Realizada']
        && request.resource.data.estadoFac in ['', 'FACTURADA', 'FINALIZADA']
        && (
          !request.resource.data.keys().hasAll(['programadaHastaDia'])
          || request.resource.data.programadaHastaDia == null
          || (
            request.resource.data.programadaHastaDia is int
            && request.resource.data.programadaHastaDia > argentinaTodayKey()
            && request.resource.data.fechaCir is string
            && request.resource.data.fechaCir != ''
            && request.resource.data.fechaSolLente is string
            && request.resource.data.fechaSolLente != ''
            && request.resource.data.fechaLlegaLente is string
            && request.resource.data.fechaLlegaLente != ''
            && request.resource.data.estadoCir != 'Realizada'
            && !(request.resource.data.estadoFac in ['FACTURADA', 'FINALIZADA'])
          )
        );
    }
    function canWriteCirugiaById(id) {
      return isActiveSuperadmin() || isSupervisor()
        || ownClinic(get(/databases/$(database)/documents/cirugias/$(id)).data.clinica);
    }
    function validAuditIdentity(id) {
      return request.resource.data.pacienteId == id
        && request.resource.data.usuarioUid == request.auth.uid
        && request.resource.data.usuarioRol == currentProfile().data.role;
    }

    match /cirugias/{id} {
      allow get, list: if canReadCirugia();
      allow create: if validCirugia()
        && (isActiveSuperadmin() || isSupervisor() || ownClinic(request.resource.data.clinica));
      allow update: if validCirugia() && canWriteCirugia();
      allow delete: if isActiveSuperadmin();
    }

    match /cirugias/{id}/historial/{entryId} {
      allow read: if isActiveSuperadmin() || isSupervisor();
      allow create: if canWriteCirugiaById(id) && validAuditIdentity(id);
      allow update, delete: if false;
    }

    match /auditoria/{entryId} {
      allow read: if isActiveSuperadmin() || isSupervisor();
      allow create: if request.resource.data.pacienteId is string
        && canWriteCirugiaById(request.resource.data.pacienteId)
        && validAuditIdentity(request.resource.data.pacienteId);
      allow update, delete: if false;
    }

    function validOperationalAlertSettings() {
      return request.resource.data.keys().hasAll([
          'second_eye_missing_warn_days', 'second_eye_missing_crit_days',
          'lens_arrived_not_scheduled_warn_days', 'lens_arrived_not_scheduled_crit_days',
          'billing_not_done_warn_days', 'billing_not_done_crit_days',
          'lens_delay_warn_days', 'lens_delay_crit_days',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'second_eye_missing_warn_days', 'second_eye_missing_crit_days',
          'lens_arrived_not_scheduled_warn_days', 'lens_arrived_not_scheduled_crit_days',
          'billing_not_done_warn_days', 'billing_not_done_crit_days',
          'lens_delay_warn_days', 'lens_delay_crit_days',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.second_eye_missing_warn_days is int
        && request.resource.data.second_eye_missing_crit_days is int
        && request.resource.data.lens_arrived_not_scheduled_warn_days is int
        && request.resource.data.lens_arrived_not_scheduled_crit_days is int
        && request.resource.data.billing_not_done_warn_days is int
        && request.resource.data.billing_not_done_crit_days is int
        && request.resource.data.lens_delay_warn_days is int
        && request.resource.data.lens_delay_crit_days is int
        && request.resource.data.second_eye_missing_warn_days > 0
        && request.resource.data.second_eye_missing_crit_days <= 365
        && request.resource.data.second_eye_missing_warn_days < request.resource.data.second_eye_missing_crit_days
        && request.resource.data.lens_arrived_not_scheduled_warn_days > 0
        && request.resource.data.lens_arrived_not_scheduled_crit_days <= 365
        && request.resource.data.lens_arrived_not_scheduled_warn_days < request.resource.data.lens_arrived_not_scheduled_crit_days
        && request.resource.data.billing_not_done_warn_days > 0
        && request.resource.data.billing_not_done_crit_days <= 365
        && request.resource.data.billing_not_done_warn_days < request.resource.data.billing_not_done_crit_days
        && request.resource.data.lens_delay_warn_days > 0
        && request.resource.data.lens_delay_crit_days <= 365
        && request.resource.data.lens_delay_warn_days < request.resource.data.lens_delay_crit_days
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /configuracion/alertas_operativas {
      allow read: if signedIn() && currentProfile().data.active == true;
      allow create, update: if (isActiveSuperadmin() || isSupervisor())
        && validOperationalAlertSettings();
      allow delete: if isActiveSuperadmin();
    }

    match /configuracion/{id} {
      allow read: if signedIn() && currentProfile().data.active == true;
      allow write: if id != 'alertas_operativas' && isActiveSuperadmin();
    }

    // Las reglas de las demás colecciones se definirán en etapas posteriores.
    // Hasta entonces quedan cerradas por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
